{
  "serverInfo": {
    "name": "Tilde Global MCP",
    "version": "0.0.6"
  },
  "transport": {
    "type": "streamable-http",
    "endpoint": "https://api.trytilde.ai/mcp"
  },
  "capabilities": {
    "tools": true,
    "resources": false,
    "prompts": false,
    "logging": true
  },
  "authentication": {
    "required": true,
    "oauthProtectedResource": "https://trytilde.ai/.well-known/oauth-protected-resource/mcp",
    "oauthAuthorizationServer": "https://trytilde.ai/.well-known/oauth-authorization-server",
    "apiKey": {
      "header": "x-api-key",
      "registration": "https://trytilde.ai/auth.md"
    }
  },
  "documentation": "https://trytilde.ai/docs",
  "instructions": "Call tilde_whoami first, then use the returned team_id for team-scoped tools."
}
