{
  "$schema": "https://mintlify.com/docs.json",
  "colors": {
    "dark": "#15803D",
    "light": "#07C983",
    "primary": "#16A34A"
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "favicon": "/favicon.svg",
  "footer": {
    "socials": {
      "github": "https://github.com/mintlify",
      "linkedin": "https://linkedin.com/company/mintlify",
      "x": "https://x.com/mintlify"
    }
  },
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "name": "Mintlify Starter Kit",
  "navbar": {
    "links": [
      {
        "href": "mailto:hi@mintlify.com",
        "label": "Support"
      }
    ],
    "primary": {
      "href": "https://dashboard.mintlify.com",
      "label": "Dashboard",
      "type": "button"
    }
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "tabs": [
      {
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "quickstart",
              "development"
            ]
          },
          {
            "group": "Customization",
            "pages": [
              "essentials/settings",
              "essentials/navigation"
            ]
          },
          {
            "group": "Writing content",
            "pages": [
              "essentials/markdown",
              "essentials/code",
              "essentials/images",
              "essentials/components",
              "essentials/reusable-snippets"
            ]
          },
          {
            "group": "Agent ready",
            "pages": [
              "agent-ready/prompt",
              "agent-ready/visibility",
              "agent-ready/contextual",
              "ai-tools/cursor",
              "ai-tools/claude-code",
              "ai-tools/windsurf"
            ]
          }
        ],
        "tab": "Guides"
      },
      {
        "groups": [
          {
            "group": "API documentation",
            "pages": [
              "api-reference/introduction"
            ]
          },
          {
            "group": "Endpoint examples",
            "pages": [
              "api-reference/endpoint/get",
              "api-reference/endpoint/create",
              "api-reference/endpoint/delete",
              "api-reference/endpoint/webhook"
            ]
          }
        ],
        "tab": "API reference"
      },
      {
        "groups": [
          {
            "group": "CLI Factory",
            "pages": [
              "projects/cli-factory/index",
              {
                "group": "Providers",
                "pages": [
                  "projects/cli-factory/providers/overview",
                  {
                    "group": "Example",
                    "pages": [
                      "projects/cli-factory/providers/example/index",
                      {
                        "expanded": true,
                        "group": "Tools",
                        "pages": [
                          "projects/cli-factory/providers/example/tools/echo"
                        ]
                      }
                    ],
                    "root": "projects/cli-factory/providers/example/index"
                  },
                  {
                    "group": "Google Workspace",
                    "pages": [
                      "projects/cli-factory/providers/google-workspace/index",
                      {
                        "expanded": true,
                        "group": "Tools",
                        "pages": [
                          "projects/cli-factory/providers/google-workspace/tools/calendar-check",
                          "projects/cli-factory/providers/google-workspace/tools/calendar-create",
                          "projects/cli-factory/providers/google-workspace/tools/gmail-check",
                          "projects/cli-factory/providers/google-workspace/tools/gmail-send"
                        ]
                      }
                    ],
                    "root": "projects/cli-factory/providers/google-workspace/index"
                  }
                ],
                "root": "projects/cli-factory/providers/overview"
              }
            ],
            "root": "projects/cli-factory/index"
          }
        ],
        "tab": "Projects"
      }
    ]
  },
  "theme": "mint"
}
