{
  "$schema": "https://mintlify.com/docs.json",
  "appearance": {
    "default": "light",
    "strict": true
  },
  "colors": {
    "dark": "#4C81DC",
    "light": "#89C0FF",
    "primary": "#0038AE"
  },
  "background": {
    "color": {
      "dark": "#2E2723",
      "light": "#FFFFFF"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "description": "Documentation for building and operating AI agents with Tilde.",
  "favicon": {
    "dark": "/favicon-dark.svg",
    "light": "/favicon.svg"
  },
  "logo": {
    "dark": "/logo/dark.svg",
    "light": "/logo/light.svg"
  },
  "fonts": {
    "family": "Inter",
    "heading": {
      "family": "Inter",
      "weight": 500
    }
  },
  "name": "Tilde documentation",
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Build",
        "pages": [
          "tools",
          "chatkit",
          "skills"
        ]
      }
    ]
  },
  "styling": {
    "codeblocks": "system",
    "eyebrows": "breadcrumbs"
  },
  "theme": "willow"
}
